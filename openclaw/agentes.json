{
  "_leia": "Declaração do projeto, não é o openclaw.json. O openclaw.json é escrito pelo próprio CLI (config patch / agents add). Gerado por `python -m sop openclaw` a partir de agentes/*.md; não edite à mão.",
  "openclaw": {
    "versao": "2026.6.5",
    "base": "~/.openclaw",
    "gateway": {
      "mode": "local"
    },
    "provedor": {
      "provider": "openai",
      "modelo": "openai/gpt-5.5",
      "auth": "oauth-device-code",
      "observacao": "Rota Codex pelo plugin nativo, autenticada por OAuth contra a assinatura ChatGPT Plus. Não usa API key."
    }
  },
  "principal": {
