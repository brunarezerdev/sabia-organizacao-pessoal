{
  "_leia": "Declaração do projeto, não é o openclaw.json. O openclaw.json é escrito pelo próprio CLI (config patch / agents add). Gerado por `python -m sop openclaw` a partir de agentes/*.md; não edite à mão.",
  "openclaw": {
    "versao": "2026.6.5",
    "base": "~/.openclaw",
    "gateway": {
      "mode": "local"
    },
    "provedor": {
      "provider": "openai",
      "modelo": "openai/gpt-5.5",
      "auth": "oauth-device-code",
      "observacao": "Rota Codex pelo plugin nativo, autenticada por OAuth contra a assinatura ChatGPT Plus. Não usa API key."
    }
  },
  "principal": {
    "id": "main",
    "nome": "Sábia",
    "emoji": "🦉",
    "descricao": "compreender a solicitação, consultar o contexto e decidir qual agente cuida dela",
    "modelo": "openai/gpt-5.5",
    "tools": [
      "fs.read",
      "grep",
      "agent.invoke"
    ],
    "workspace": "~/.openclaw/workspace",
    "alma": "openclaw/workspaces/main/SOUL.md"
  },
  "subagentes": [
    {
      "id": "elefante",
      "nome": "Elefante",
      "emoji": "🐘",
      "descricao": "memória, documentos, histórico, estudo e material de referência",
      "modelo": "openai/gpt-5.5",
      "tools": [
        "fs.read",
        "fs.write",
        "web.fetch"
      ],
      "workspace": "~/.openclaw/workspace-elefante",
      "alma": "openclaw/workspaces/elefante/SOUL.md"
    },
    {
      "id": "esquilo",
      "nome": "Esquilo",
      "emoji": "🐿️",
      "descricao": "finanças, compras, estoque e patrimônio",
      "modelo": "openai/gpt-5.5",
      "tools": [
        "fs.read",
        "fs.write"
      ],
      "workspace": "~/.openclaw/workspace-esquilo",
      "alma": "openclaw/workspaces/esquilo/SOUL.md"
    },
    {
      "id": "raposa",
      "nome": "Raposa",
      "emoji": "🦊",
      "descricao": "estratégia, projetos, metas e prioridades",
      "modelo": "openai/gpt-5.5",
      "tools": [
        "fs.read",
        "fs.write"
      ],
      "workspace": "~/.openclaw/workspace-raposa",
      "alma": "openclaw/workspaces/raposa/SOUL.md"
    }
  ]
}
