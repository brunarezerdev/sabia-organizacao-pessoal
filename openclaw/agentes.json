    "nome": "Orquestradora",
    "emoji": "🧭",
    "descricao": "triagem das mensagens e roteamento para os agentes",
    "modelo": "openai/gpt-5.5",
    "tools": [
      "fs.read",
      "grep",
      "agent.invoke"
    ],
    "workspace": "~/.openclaw/workspace",
    "alma": "openclaw/workspaces/main/SOUL.md"
  },
  "subagentes": [
