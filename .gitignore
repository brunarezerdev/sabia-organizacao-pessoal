# ---------------------------------------------------------------------------
# Segredos e credenciais — NUNCA versionar
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials.json
client_secret*.json
token.json
token*.pickle
*session*.txt
*cookie*
.secrets/
secrets/
service-account*.json
oauth*.json

# ---------------------------------------------------------------------------
# Dados reais — este repositório usa apenas dados fictícios
# ---------------------------------------------------------------------------
dados/
data/
vault/
*.sqlite
*.sqlite3
*.db
exportacoes/
backup/
backups/

# ---------------------------------------------------------------------------
# Fila local e artefatos de execução
# ---------------------------------------------------------------------------
.fila/
*.log
logs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node — o runtime dos agentes é instalado aqui dentro
# ---------------------------------------------------------------------------
# O OpenClaw entra por `npm install` local, na pasta do projeto, para não
# precisar de root nesta máquina. São ~85 MB de código de terceiros: fica de
# fora do versionamento. O package-lock.json versionado é o que reproduz a
# instalação, com `npm ci`.
node_modules/
npm-debug.log*

# ---------------------------------------------------------------------------
# Sistema operacional / editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Estrutura Sábia — dados de operação, não de código
# ---------------------------------------------------------------------------
# A fila carrega o conteúdo real das mensagens da Bruna e do Wagner. A estrutura
# de pastas é versionada (pelos .gitkeep), o conteúdo não.
sabia/fila/entrada/*
sabia/fila/saida/*
sabia/fila/processadas/*
sabia/fila/ledger.jsonl
!sabia/fila/*/.gitkeep

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
# `.vercel/` guarda o vínculo local com o projeto (projectId/orgId) e o cache
# de build da CLI. É estado de máquina, não de repositório.
.vercel/
