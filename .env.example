# ---------------------------------------------------------------------------
# Sistema Operacional Pessoal — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com as suas credenciais.
#   cp .env.example .env
#
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
# Todas as variáveis abaixo estão vazias de propósito.
# ---------------------------------------------------------------------------

# --- Telegram (captura de mensagens) --------------------------------------
# Criado pelo @BotFather no Telegram. Formato: 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Identificador numérico do chat autorizado a conversar com o sistema.
# Somente mensagens vindas deste chat são processadas.
TELEGRAM_CHAT_ID_AUTORIZADO=

# --- Notion (banco de dados no-code) ---------------------------------------
# Token de integração interna: https://www.notion.so/my-integrations
# Formato: ntn_...
NOTION_TOKEN=

# ID da database do Notion onde os itens são gravados (32 caracteres).
# Aparece na URL da database.
NOTION_DATABASE_ID=

# ID da database de Regras, que guarda as regras se-então do motor.
# É a base que a pessoa edita à mão para mudar o comportamento do sistema,
# sem programar. Se ficar vazia, o motor roda com exemplos/regras.json.
NOTION_REGRAS_DATABASE_ID=

# ID da página do Ritual de Domingo. Usado por `sop ritual --publicar` para
# acrescentar o pacote da semana no fim da página. Só acrescenta, nunca apaga.
NOTION_RITUAL_PAGE_ID=

# --- Google Agenda (leitura e escrita de eventos) --------------------------
# Caminho para o JSON de credenciais OAuth baixado do Google Cloud Console.
# Mantenha o arquivo FORA do repositório.
GOOGLE_CREDENTIALS_PATH=

# Caminho onde o token de acesso será salvo após o primeiro login.
GOOGLE_TOKEN_PATH=

# E-mail do calendário alvo. Use "primary" para o calendário padrão da conta.
GOOGLE_CALENDAR_ID=primary

# --- Camada de IA (classificação das mensagens) ----------------------------
# Chave da API da Anthropic: https://console.anthropic.com/
# Se ficar vazia, o sistema cai automaticamente no classificador heurístico
# local (sem IA, baseado em palavras-chave) e continua funcionando.
ANTHROPIC_API_KEY=

# Modelo usado na classificação.
ANTHROPIC_MODEL=claude-opus-5

# --- Geral -----------------------------------------------------------------
# Fuso horário usado para interpretar datas relativas ("amanhã", "sexta").
TIMEZONE=America/Sao_Paulo

# Diretório da fila durável de tarefas.
FILA_DIR=.fila
