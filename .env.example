# ---------------------------------------------------------------------------
# Sistema Operacional Pessoal — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com as suas credenciais.
#   cp .env.example .env
#
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
# Todas as variáveis abaixo estão vazias de propósito.
# ---------------------------------------------------------------------------

# --- Telegram (captura de mensagens) --------------------------------------
# Criado pelo @BotFather no Telegram. Formato: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Alternativa recomendada: em vez do segredo aqui, o CAMINHO de um arquivo em
# modo 0600 fora do repositório. Qualquer variável de segredo aceita a forma
# <NOME>_PATH, e o valor direto tem prioridade quando os dois existem.
TELEGRAM_BOT_TOKEN_PATH=

# Identificador numérico do chat autorizado a conversar com o sistema.
# Somente mensagens vindas deste chat são processadas.
TELEGRAM_CHAT_ID_AUTORIZADO=

# Chat da Bruna que recebe o briefing diário da Sábia. A rotina recusa rodar
# sem destino explícito, para nunca entregar o briefing à última conversa por
# engano.
SOP_BRIEFING_CHAT_ID=

# --- Notion (banco de dados no-code) ---------------------------------------
# Token de integração interna: https://www.notion.so/my-integrations
# Formato: ntn_...
NOTION_TOKEN=
# Mesma ideia: caminho de um arquivo 0600 em vez do token em texto claro.
NOTION_TOKEN_PATH=

# ID da database do Notion onde os itens são gravados (32 caracteres).
# Aparece na URL da database.
NOTION_DATABASE_ID=

# ID da database de Regras, que guarda as regras se-então do motor.
# É a base que a pessoa edita à mão para mudar o comportamento do sistema,
# sem programar. Se ficar vazia, o motor roda com exemplos/regras.json.
NOTION_REGRAS_DATABASE_ID=

# ID da página do Ritual de Domingo. Usado por `sop ritual --publicar` para
# acrescentar o pacote da semana no fim da página. Só acrescenta, nunca apaga.
NOTION_RITUAL_PAGE_ID=

# Base onde cada domingo vira um registro próprio. `sop ritual --publicar`
# cria uma página por data e fecha os registros anteriores sem apagar nada.
NOTION_RITUAIS_DATABASE_ID=

# Base opcional "Prazos e tarefas". Tarefas com Feito marcado e prazo dentro
# da semana encerrada entram automaticamente no fechamento.
NOTION_TAREFAS_DATABASE_ID=

# Bases do Pomar. A rotina de compras cruza planejamento, receitas e
# ingredientes; não cria uma quarta base, pois Compras é uma view filtrada.
NOTION_CARDAPIO_DATABASE_ID=
NOTION_RECEITAS_DATABASE_ID=
NOTION_INGREDIENTES_DATABASE_ID=

# --- Google Agenda (leitura e escrita de eventos) --------------------------
# Caminho para o JSON de credenciais OAuth baixado do Google Cloud Console.
# Mantenha o arquivo FORA do repositório.
GOOGLE_CREDENTIALS_PATH=

# Caminho onde o token de acesso será salvo após o primeiro login.
GOOGLE_TOKEN_PATH=

# --- Google Agenda, rota 2: conta de serviço -------------------------------
# Caminho do JSON da chave de conta de serviço. É a rota que não precisa de um
# humano no navegador para renovar consentimento, então é a que sustenta uma
# operação sem supervisão. Exige compartilhar a agenda com o e-mail da conta de
# serviço (no Google Agenda: Configurações da agenda, "Compartilhar com pessoas
# específicas", permissão "Fazer alterações nos eventos").
#
# Basta UMA das duas rotas: GOOGLE_TOKEN_PATH ou GOOGLE_SERVICE_ACCOUNT_PATH.
# Com as duas preenchidas, a conta de serviço vence.
GOOGLE_SERVICE_ACCOUNT_PATH=

# E-mail do calendário alvo. Use "primary" para o calendário padrão da conta.
GOOGLE_CALENDAR_ID=primary

# --- Camada de IA: OpenClaw (rota principal) -------------------------------
# Os agentes rodam no OpenClaw, e é lá que o provedor de IA está autenticado.
#
# ATENÇÃO: o provedor escolhido é `openai`, rota Codex, e ela autentica por
# OAuth (device-code) contra a assinatura ChatGPT Plus. NÃO existe API key
# para o Codex CLI e nenhuma variável aqui guarda credencial dele. O login é
# feito uma vez por `bash scripts/openclaw/configurar_provedor_openai.sh`.

# Backend de classificação. Vazio deixa o sistema escolher, nesta ordem:
# openclaw -> openai -> anthropic -> heuristica.
# Valores aceitos: openclaw | openai | anthropic | heuristica
IA_BACKEND=

# Pasta de configuração do OpenClaw.
OPENCLAW_BASE=~/.openclaw

# Id do agente principal (a orquestradora) dentro do OpenClaw.
OPENCLAW_AGENTE=main

# Modelo primário. Formato provider/modelo.
OPENCLAW_MODELO=openai/gpt-5.5

# Linha de comando que invoca o agente de forma não interativa. `{agente}` é
# substituído por OPENCLAW_AGENTE. A instrução vai pela entrada padrão e o
# JSON é lido da saída padrão.
#
# PONTO A CONFIRMAR: a invocação não interativa exata varia com a versão do
# CLI. Confira com `openclaw agents --help` na sua máquina antes de preencher.
# Enquanto estiver vazia, o sistema usa o classificador heurístico local.
# Ver docs/openclaw.md.
OPENCLAW_COMANDO=

# Segundos de espera pela resposta do CLI.
OPENCLAW_TIMEOUT=120

# --- Camada de IA: rotas alternativas por API key (opcionais) --------------
# Só preencha se quiser trocar o OpenClaw por uma chamada direta de API.
# Nada disso é necessário para a rota Codex.

# Chave da OpenAI: https://platform.openai.com/api-keys
# NÃO é a credencial do Codex CLI, que não usa chave. São coisas diferentes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Chave da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Geral -----------------------------------------------------------------
# Fuso horário usado para interpretar datas relativas ("amanhã", "sexta").
TIMEZONE=America/Sao_Paulo

# Diretório da fila durável de tarefas.
FILA_DIR=.fila

# --- Ambiente público de demonstração -------------------------------------
# Trava obrigatória para rotas que acessam somente dados sintéticos.
SABIA_DEMO=

# Bases exclusivas da demonstração. Nunca use aqui IDs de bases pessoais.
NOTION_LANCAMENTOS_DEMO_ID=
NOTION_CUSTOS_DEMO_ID=
NOTION_ORCAMENTO_DEMO_ID=
NOTION_INGREDIENTES_DEMO_ID=
